# Server-only provider configuration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Supabase public browser configuration. These are safe to expose in the
# browser when Row Level Security is enabled on the memories table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
